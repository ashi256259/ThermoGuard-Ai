# ThermoGuard AI - Environment Configuration
# SIH 2026 | PS ID: SIH26162 | NTRO
# NOTE: Phase 1 operates 100% offline in DEMO mode without requiring any external keys.

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://thermoguard:guard_secure@localhost:5432/thermoguard_db

# Frontend API Base URL (leave empty for same-origin dev proxy)
VITE_API_BASE_URL=

# NASA FIRMS API (Free registration at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_API_KEY=

# OpenStreetMap Overpass API
OSM_API_URL=https://overpass-api.de/api/interpreter

# Application Operating Mode (DEMO or LIVE)
DATA_MODE=DEMO
DATA_PROVIDER_MODE=DEMO_SAMPLE_DATA

# Land Cover Data Provider (WMS/WCS Sentinel-2 / ESA WorldCover endpoint)
LANDCOVER_API_URL=https://services.terrascope.be/wms/v2

# Machine Learning Model Artifact
MODEL_PATH=./ml/models/random_forest_v1.pkl

# Temporal Intelligence Engine Settings
TEMPORAL_CLUSTER_RADIUS_KM=1.2
TEMPORAL_CLUSTER_WINDOW_HOURS=720.0
TEMPORAL_INACTIVE_GAP_HOURS=24.0
TEMPORAL_PERSISTENCE_DAYS_PERSISTENT=21
TEMPORAL_PERSISTENCE_DAYS_TRANSIENT=3
TEMPORAL_MIN_OBSERVATIONS_FOR_SEASONALITY=5

# Optional Gemini API Key (Used strictly for human-readable evidence narration, NOT classification)
GEMINI_API_KEY=
